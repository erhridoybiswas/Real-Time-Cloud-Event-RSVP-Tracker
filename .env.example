# ---------- Security ----------
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET=change-me-too-another-long-random-string
JWT_EXP_MINUTES=120

# ---------- Database ----------
DATABASE_PATH=./data/app.db

# ---------- CORS ----------
CORS_ORIGINS=*

# ---------- Rate limiting ----------
RATE_LIMIT_PER_MINUTE=240

# ---------- Bootstrap ----------
# First user registering with header  X-Bootstrap-Key: <this value>  becomes ADMIN
BOOTSTRAP_KEY=make-me-something-secret

# ---------- Server ----------
PORT=5000
FLASK_DEBUG=0